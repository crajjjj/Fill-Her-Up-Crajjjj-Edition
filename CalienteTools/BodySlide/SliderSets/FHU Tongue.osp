        <OutputFile GenWeights="false">linga1</OutputFile>
        <Shape target="Tongue">Tongue</Shape>
        <Slider name="TongueUp" invert="false" default="0">
            <Data name="TongueTongueUp" target="Tongue" local="true">FHU Tongue 01.osd\TongueTongueUp</Data>
        </Slider>
        <Slider name="TongueBack" invert="false" default="0">
            <Data name="TongueTongueBack" target="Tongue" local="true">FHU Tongue 01.osd\TongueTongueBack</Data>
        </Slider>
        <Slider name="TongueFront" invert="false" default="0">
            <Data name="TongueTongueFront" target="Tongue" local="true">FHU Tongue 01.osd\TongueTongueFront</Data>
        </Slider>
